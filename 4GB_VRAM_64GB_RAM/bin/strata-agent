#!/usr/bin/env bash
# strata-agent - serve Swift 1.5 Qwen3.8-Flash-Next IQ3_XXS for agent use on a 4 GB GPU + 64 GB RAM machine:
# 128K context, 4096-token prompt chunks, images through the vision projector on the CPU.
#
# Measured 2026-11-08 on an RTX 3050 Ti Laptop (4 GB, PCIe Gen 4 x8, AC power) + i7-12700H + 64 GB RAM:
#   cold 25K-token system prompt 462-478 tok/s (52-54 s), ~3K-token agent turns ~390 tok/s (7.6-8 s), decode ~17-19
#   tok/s; a repeated system prompt is reused from the cache (a new conversation reads only its new tokens).
#   (The earlier 768-token chunks with pageable experts: 180 tok/s cold, 160-168 tok/s turns, the same decode.)
#
# The PCIe link: the NVIDIA driver sometimes leaves it stuck at Gen 1 (~1 GB/s instead of ~13; prompt reading ~4x
# slower).  Before loading anything strata-agent measures it (pcie-probe), and while serving it watches for the stuck
# state (GPU busy but the link at Gen 1 for 10 s, read from nvidia-smi - nothing on the GPU is touched).  Either way it
# tells you; retraining the link is your call (`gpu-mode retrain`), because a retrain once made the GPU fall off the
# bus (NVRM Xid 79, a reboot to recover).  AUTO_RETRAIN=1 lets it retrain by itself through the root helper
# (install.sh --system) - at startup, and while serving at most once every 5 minutes.
#
# Settings: ~/.config/strata-agent.conf (written by install.sh); any of them can be overridden from the environment:
#   REPO=~/dev/UnbiasedStrata  MODEL_DIR=~/dev/models/swift-iq3_xxs  HOST=127.0.0.1  PORT=18090
#   CONTEXT=131072  CHUNK=4096  PIN_EXPERTS=1  VISION=1  VISION_THREADS=12  WATCH_LINK=1  AUTO_RETRAIN=0
# Extra arguments go to the engine (after the front end's `--`).
set -uo pipefail

CONF=${STRATA_AGENT_CONF:-$HOME/.config/strata-agent.conf}
_env_REPO=${REPO-}; _env_MODEL_DIR=${MODEL_DIR-}; _env_HOST=${HOST-}; _env_PORT=${PORT-}; _env_CONTEXT=${CONTEXT-}
_env_CHUNK=${CHUNK-}; _env_VISION=${VISION-}; _env_VISION_THREADS=${VISION_THREADS-}
_env_WATCH_LINK=${WATCH_LINK-}; _env_AUTO_RETRAIN=${AUTO_RETRAIN-}; _env_PIN_EXPERTS=${PIN_EXPERTS-}
# shellcheck disable=SC1090
[[ -r $CONF ]] && source "$CONF"
REPO=${_env_REPO:-${REPO:-$HOME/dev/UnbiasedStrata}}
MODEL_DIR=${_env_MODEL_DIR:-${MODEL_DIR:-$HOME/dev/models/swift-iq3_xxs}}
HOST=${_env_HOST:-${HOST:-127.0.0.1}}
PORT=${_env_PORT:-${PORT:-18090}}
CONTEXT=${_env_CONTEXT:-${CONTEXT:-131072}}
CHUNK=${_env_CHUNK:-${CHUNK:-4096}}
PIN_EXPERTS=${_env_PIN_EXPERTS:-${PIN_EXPERTS:-1}}
VISION=${_env_VISION:-${VISION:-1}}
VISION_THREADS=${_env_VISION_THREADS:-${VISION_THREADS:-12}}
WATCH_LINK=${_env_WATCH_LINK:-${WATCH_LINK:-1}}
AUTO_RETRAIN=${_env_AUTO_RETRAIN:-${AUTO_RETRAIN:-0}}
HELPER=/usr/local/sbin/gpu-link-retrain

# the model files: flat (prepare-model.sh's layout) or as `hf download --local-dir` leaves them (IQ3_XXS/)
SH1=$(ls "$MODEL_DIR"/Swift-*-IQ3_XXS-00001-of-00002.gguf "$MODEL_DIR"/IQ3_XXS/Swift-*-IQ3_XXS-00001-of-00002.gguf 2>/dev/null | head -1)
MMPROJ=$(ls "$MODEL_DIR"/mmproj-*.gguf 2>/dev/null | head -1)
[[ -n $SH1 ]] || { echo "strata-agent: no Swift ...IQ3_XXS-00001-of-00002.gguf in $MODEL_DIR (run prepare-model.sh)" >&2; exit 1; }
[[ -d $MODEL_DIR/pack ]] || { echo "strata-agent: no pack in $MODEL_DIR/pack (run prepare-model.sh)" >&2; exit 1; }
[[ -x $REPO/build/bin/strata ]] || { echo "strata-agent: $REPO/build/bin/strata is missing (build the engine)" >&2; exit 1; }

cat /sys/class/power_supply/ADP*/online /sys/class/power_supply/AC*/online 2>/dev/null | head -1 | grep -q '^0$' &&
    echo "strata-agent: WARNING: on battery - the GPU is capped (20 W on the 3050 Ti laptop) and the PCIe link stays slow" >&2

PROBE=$HOME/.local/share/gpu-mode/pcie-probe
if [[ -x $PROBE ]]; then
    gbs=$("$PROBE" 2>/dev/null || echo 0)
    if awk -v g="$gbs" 'BEGIN { exit !(g == 0) }'; then
        echo "strata-agent: the PCIe probe could not use the GPU (nvidia-smi working? another engine running?)" >&2
    elif awk -v g="$gbs" 'BEGIN { exit !(g < 5) }'; then
        if [[ $AUTO_RETRAIN == 1 ]] && sudo -n "$HELPER" >&2 2>/dev/null; then
            echo "strata-agent: PCIe link was stuck ($gbs GB/s); retrained it (AUTO_RETRAIN=1)" >&2
            sleep 5   # let the link settle before anything uses the GPU again
            gbs=$("$PROBE" 2>/dev/null || echo 0)
        fi
        if awk -v g="$gbs" 'BEGIN { exit !(g < 5) }'; then
            echo "strata-agent: WARNING: the PCIe link is stuck at Gen 1 ($gbs GB/s, should be ~13): prompt reading" \
                 "will be ~4x slower. Fix: Ctrl-C, run  gpu-mode retrain , start strata-agent again." >&2
        fi
    fi
    echo "strata-agent: PCIe host->GPU $gbs GB/s" >&2
fi

# ---- while serving: the GPU busy (>= 10% utilization) with the link at Gen 1 in 5 samples in a row (2 s apart).
# Measured on a healthy link: every busy sample was at Gen 4 (144 of 144 through prompt reading and decoding).
watch_link() {
    local util gen n=0 warned=0 fixed=-1000
    while IFS=', ' read -r util gen; do
        [[ $util =~ ^[0-9]+$ && $gen =~ ^[0-9]+$ ]] || continue
        (( util < 10 )) && continue                 # idle: Gen 1 is normal power saving
        if (( gen > 1 )); then n=0; warned=0; continue; fi
        (( ++n < 5 )) && continue
        n=0
        if [[ $AUTO_RETRAIN == 1 ]] && (( SECONDS - fixed > 300 )) && sudo -n "$HELPER" >/dev/null 2>&1; then
            fixed=$SECONDS
            printf '\n*** strata-agent: the PCIe link dropped to Gen 1 while serving; retrained it (AUTO_RETRAIN=1)\n\n' >&2
        elif (( !warned )); then
            warned=1
            printf '\n*** strata-agent: the PCIe link dropped to Gen 1 while serving: prompt reading is ~4x slower now.\n' >&2
            printf '*** Fix between requests: Ctrl-C, run  gpu-mode retrain , start strata-agent again.\n\n' >&2
        fi
    done
}
WATCH_PIDS=()
if [[ $WATCH_LINK == 1 ]] && command -v nvidia-smi >/dev/null; then
    WDIR=$(mktemp -d)
    mkfifo "$WDIR/smi"
    nvidia-smi --query-gpu=utilization.gpu,pcie.link.gen.current --format=csv,noheader,nounits -lms 2000 \
        > "$WDIR/smi" 2>/dev/null &
    WATCH_PIDS+=($!)
    watch_link < "$WDIR/smi" &
    WATCH_PIDS+=($!)
    # background jobs of a script ignore Ctrl-C, so stop them on every way out: Ctrl-C, kill, a closed terminal, exit
    stop_watch() { kill "${WATCH_PIDS[@]}" 2>/dev/null; rm -rf "$WDIR"; }
    trap stop_watch EXIT
    trap 'stop_watch; trap - INT; kill -INT $$' INT
    trap 'stop_watch; exit 143' TERM
    trap 'stop_watch; exit 129' HUP
fi

FRONT=()
ENGINE=()
if [[ $VISION == 1 && -n $MMPROJ ]]; then
    FRONT+=(--mmproj "$MMPROJ" --threads "$VISION_THREADS")   # encoded on the CPU (the card has no room for it)
    ENGINE+=(--vision)
fi

cd "$REPO" || exit 1
# the engine options, and why (4GB_VRAM_64GB_RAM/README.md has the measurements):
#   STRATA_HC_REQ8=1            hyper-connection projections as int8: ~525 MiB of VRAM back (the head fits)
#   STRATA_IDX_HOST=1           indexer pooled keys + RoPE table in pinned RAM (this fork)
#   STRATA_PREFILL_IN_HEAD=1    the prompt path's buffers in the output head's VRAM, head restored after (this fork)
#   STRATA_PREFILL_IN_DENSE=1   ... and in the dense projections' VRAM (1.6 GiB, one block - 118 MiB less than 300
#                               separate allocations): while a prompt is read each layer's projections are streamed
#                               from a pinned RAM copy into two slots, and the block is written back after the prompt
#                               (~0.17 s with the head).  That room is what lets a chunk be 4096 tokens; every chunk
#                               streams all 42.9 GB of experts over PCIe (3.3 s), so bigger chunks read faster (this fork)
#   STRATA_PF_GEMM_*_MIB        smaller prompt GEMM scratch/workspace (this fork)
#   PIN_EXPERTS=1               the experts' RAM copy page-locked (--resident-experts' default): the GPU copies them
#                               straight from it instead of through CPU staging copies (+26% prompt reading); ~80 MiB
#                               of VRAM in page tables.  If 40 GiB cannot be locked the engine falls back to pageable
#                               RAM by itself.  PIN_EXPERTS=0 sets STRATA_RESIDENT_PIN=0 (pageable, as before)
#   --expert-cache 1            the verify path needs one slot; there is no VRAM for more
#   --suffix-draft 0            keeps the verify window at 2 rows: its graphs fit in what is left
#   --short-read 0              required by STRATA_PREFILL_IN_HEAD
#   --kv q4_0 --kv-resident 20480   4-bit K/V streamed from pinned RAM, 20480 cells per layer in VRAM (the minimum)
#   --resident-experts          the experts the GPU does not hold kept in RAM (needs ~44 GiB available at start)
export CUDA_MODULE_LOADING=LAZY STRATA_HC_REQ8=1 \
       STRATA_IDX_HOST=1 STRATA_PREFILL_IN_HEAD=1 STRATA_PREFILL_IN_DENSE=1 \
       STRATA_PF_GEMM_SCRATCH_MIB=16 STRATA_PF_GEMM_WS_MIB=4
if [[ $PIN_EXPERTS == 1 ]]; then unset STRATA_RESIDENT_PIN; else export STRATA_RESIDENT_PIN=0; fi

build/bin/unbiased-strata --engine build/bin/strata -m "$SH1" \
  --host "$HOST" --port "$PORT" --alias swift-iq3_xxs "${FRONT[@]}" \
  -- --pack "$MODEL_DIR/pack" --native "$SH1" \
     --expert-profile data/expert-profile.bin --expert-cache 1 --vram-reserve-mib 150 \
     --prefill "$CHUNK" --spec 2 --suffix-draft 0 --short-read 0 \
     --max-context "$CONTEXT" --kv q4_0 --kv-resident 20480 --resident-experts "${ENGINE[@]}" "$@" 2>&1 |
while IFS= read -r line; do
    printf '%s\n' "$line"
    if [[ $line =~ PCIe\ probe:\ ([0-9.]+)\ GB/s ]] && awk -v g="${BASH_REMATCH[1]}" 'BEGIN { exit !(g < 5) }'; then
        printf '\n*** strata-agent: the PCIe link is stuck (%s GB/s, should be ~13): prompt reading will be ~4x slower.\n' \
               "${BASH_REMATCH[1]}" >&2
        printf '*** Stop this (Ctrl-C), run:  gpu-mode retrain   and start strata-agent again.\n\n' >&2
    fi
    if [[ $line == *"FileExpertSource:"*"trying pageable memory"* ]]; then
        printf '\n*** strata-agent: the experts could not be page-locked (not enough free RAM): prompt reading ~20%% slower.\n' >&2
        printf '*** Close memory-heavy programs and restart for full speed.\n\n' >&2
    fi
    if [[ $line == *"the whole resident RAM mode does not fit"* ]]; then
        printf '\n*** strata-agent: not all experts fit in RAM - close memory-heavy programs and restart for full speed.\n\n' >&2
    fi
    if [[ $line == *"device buffers for a chunk of"*"do not fit"* ]]; then
        printf '\n*** strata-agent: the %s-token chunk did not fit; the engine stepped down to a smaller one.\n\n' "$CHUNK" >&2
    fi
done
